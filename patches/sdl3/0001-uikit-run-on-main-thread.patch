--- a/src/video/uikit/SDL_uikitvideo.m
+++ b/src/video/uikit/SDL_uikitvideo.m
@@ -50,6 +50,66 @@ @implementation SDL_UIKitVideoData
 static bool UIKit_VideoInit(SDL_VideoDevice *_this);
 static void UIKit_VideoQuit(SDL_VideoDevice *_this);
 
+void UIKit_RunOnMainThreadSync(dispatch_block_t block)
+{
+    if ([NSThread isMainThread]) {
+        block();
+    } else {
+        dispatch_sync(dispatch_get_main_queue(), block);
+    }
+}
+
+/* Voxelium: the driver's entry points touch UIKit, which must only be used on
+ * the main thread. When SDL is driven from another thread, each one runs on
+ * the main thread and the caller waits, so SDL behaves as if it were called
+ * there. GL entry points stay on the caller's thread: an EAGLContext is
+ * current per thread. PumpEvents is handled in SDL_uikitevents.m. */
+#define UIKIT_ON_MAIN(type, name, params, args)                  \
+    static type UIKitMain_##name params                          \
+    {                                                            \
+        __block type result;                                     \
+        UIKit_RunOnMainThreadSync(^{ result = UIKit_##name args; }); \
+        return result;                                           \
+    }
+#define UIKIT_ON_MAIN_VOID(name, params, args)                   \
+    static void UIKitMain_##name params                          \
+    {                                                            \
+        UIKit_RunOnMainThreadSync(^{ UIKit_##name args; });      \
+    }
+
+UIKIT_ON_MAIN(bool, VideoInit, (SDL_VideoDevice *_this), (_this))
+UIKIT_ON_MAIN_VOID(VideoQuit, (SDL_VideoDevice *_this), (_this))
+UIKIT_ON_MAIN(bool, GetDisplayModes, (SDL_VideoDevice *_this, SDL_VideoDisplay *display), (_this, display))
+UIKIT_ON_MAIN(bool, SetDisplayMode, (SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_DisplayMode *mode), (_this, display, mode))
