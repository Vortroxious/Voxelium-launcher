+UIKIT_ON_MAIN(bool, CreateWindow, (SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID create_props), (_this, window, create_props))
+UIKIT_ON_MAIN_VOID(SetWindowTitle, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+UIKIT_ON_MAIN_VOID(SetWindowSize, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+UIKIT_ON_MAIN_VOID(ShowWindow, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+UIKIT_ON_MAIN_VOID(HideWindow, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+UIKIT_ON_MAIN_VOID(SetWindowBordered, (SDL_VideoDevice *_this, SDL_Window *window, bool bordered), (_this, window, bordered))
+UIKIT_ON_MAIN(SDL_FullscreenResult, SetWindowFullscreen, (SDL_VideoDevice *_this, SDL_Window *window, SDL_VideoDisplay *display, SDL_FullscreenOp fullscreen), (_this, window, display, fullscreen))
+UIKIT_ON_MAIN_VOID(DestroyWindow, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+UIKIT_ON_MAIN(bool, GetDisplayUsableBounds, (SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_Rect *rect), (_this, display, rect))
+UIKIT_ON_MAIN_VOID(GetWindowSizeInPixels, (SDL_VideoDevice *_this, SDL_Window *window, int *w, int *h), (_this, window, w, h))
+#ifdef SDL_IPHONE_KEYBOARD
+UIKIT_ON_MAIN(bool, HasScreenKeyboardSupport, (SDL_VideoDevice *_this), (_this))
+UIKIT_ON_MAIN(bool, StartTextInput, (SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID props), (_this, window, props))
+UIKIT_ON_MAIN(bool, StopTextInput, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+UIKIT_ON_MAIN_VOID(SetTextInputProperties, (SDL_VideoDevice *_this, SDL_Window *window, SDL_PropertiesID props), (_this, window, props))
+UIKIT_ON_MAIN(bool, UpdateTextInputArea, (SDL_VideoDevice *_this, SDL_Window *window), (_this, window))
+#endif
+UIKIT_ON_MAIN(bool, SetClipboardText, (SDL_VideoDevice *_this, const char *text), (_this, text))
+UIKIT_ON_MAIN(char *, GetClipboardText, (SDL_VideoDevice *_this), (_this))
+UIKIT_ON_MAIN(bool, HasClipboardText, (SDL_VideoDevice *_this), (_this))
+#ifdef SDL_VIDEO_VULKAN
