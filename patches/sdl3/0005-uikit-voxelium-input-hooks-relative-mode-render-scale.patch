 /* Voxelium: SDL runs on a thread of the app's choosing (Minecraft's render
  * thread, through LWJGL), not necessarily the iOS main thread. Runs the block
  * on the main thread and waits for it; runs it directly when already there. */
diff --git a/src/video/uikit/SDL_uikitvoxelium.m b/src/video/uikit/SDL_uikitvoxelium.m
new file mode 100644
index 0000000..3135248
--- /dev/null
+++ b/src/video/uikit/SDL_uikitvoxelium.m
@@ -0,0 +1,92 @@
+/*
+  Voxelium: input hooks for an app that draws its own touch controls over SDL's
+  window (Minecraft 26.3 inside the Voxelium launcher). The controls turn touches
+  into keyboard and mouse input. Sending it through SDL's own keyboard and mouse
+  code keeps SDL's state (SDL_GetKeyboardState, SDL_GetModState, button state)
+  in step with the events, as for a real keyboard and mouse.
+
+  Call these on the main thread, where UIKit delivers touches and SDL's UIKit
+  backend sends its own input.
+*/
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_UIKIT
+
+#include "../SDL_sysvideo.h"
+#include "../../events/SDL_keyboard_c.h"
+#include "../../events/SDL_mouse_c.h"
+#include "../../events/SDL_windowevents_c.h"
+
+#include "SDL_uikitvideo.h"
+
+// The window input goes to: the focused one, else the first (the game has one).
+static SDL_Window *VX_Window(void)
+{
+    SDL_Window *window = SDL_GetKeyboardFocus();
+    if (!window) {
+        window = SDL_GetMouseFocus();
+    }
+    if (!window) {
+        SDL_VideoDevice *device = SDL_GetVideoDevice();
+        window = device ? device->windows : NULL;
+    }
+    return window;
+}
+
+SDL_DECLSPEC void SDLCALL SDL_VoxeliumSendKey(SDL_Scancode scancode, bool down)
+{
+    SDL_SendKeyboardKey(0, SDL_DEFAULT_KEYBOARD_ID, 0, scancode, down);
+}
+
+SDL_DECLSPEC void SDLCALL SDL_VoxeliumSendText(const char *utf8)
+{
+    SDL_SendKeyboardText(utf8);
+}
+
+SDL_DECLSPEC void SDLCALL SDL_VoxeliumSendMouseButton(Uint8 button, bool down)
+{
+    SDL_SendMouseButton(0, VX_Window(), SDL_DEFAULT_MOUSE_ID, button, down);
+}
+
+// relative: x/y are a delta (mouse look); otherwise a position in window points.
+SDL_DECLSPEC void SDLCALL SDL_VoxeliumSendMouseMotion(bool relative, float x, float y)
+{
+    SDL_SendMouseMotion(0, VX_Window(), SDL_DEFAULT_MOUSE_ID, relative, x, y);
+}
+
+SDL_DECLSPEC void SDLCALL SDL_VoxeliumSendMouseWheel(float x, float y)
+{
+    SDL_SendMouseWheel(0, VX_Window(), SDL_DEFAULT_MOUSE_ID, x, y, SDL_MOUSEWHEEL_NORMAL);
+}
+
+// What the window's close button would do: the game quits and saves.
+SDL_DECLSPEC void SDLCALL SDL_VoxeliumRequestClose(void)
+{
+    SDL_Window *window = VX_Window();
+    if (window) {
+        SDL_SendWindowEvent(window, SDL_EVENT_WINDOW_CLOSE_REQUESTED, 0, 0);
+    }
+}
+
+// Whether the game turned relative mouse mode on, i.e. it captured the mouse
+// (in the world, not in a menu).
+SDL_DECLSPEC bool SDLCALL SDL_VoxeliumRelativeMouseMode(void)
+{
+    return SDL_GetMouse()->relative_mode;
+}
+
+/* Render resolution: the launcher's VOXELIUM_RENDER_SCALE (0.1 - 1, default 1)
+   times the screen's native scale for high-pixel-density windows, so the
+   Vulkan swapchain is that much smaller than the screen. */
+float UIKit_VoxeliumRenderScale(void)
+{
+    static float scale;
+    if (scale == 0.0f) {
+        const char *s = SDL_getenv("VOXELIUM_RENDER_SCALE");
+        float v = s ? (float)SDL_atof(s) : 1.0f;
+        scale = (v > 0.1f && v <= 1.0f) ? v : 1.0f;
+    }
+    return scale;
+}
+
+#endif // SDL_VIDEO_DRIVER_UIKIT
diff --git a/src/video/uikit/SDL_uikitwindow.m b/src/video/uikit/SDL_uikitwindow.m
index 3e538f2..d1e95cf 100644
--- a/src/video/uikit/SDL_uikitwindow.m
+++ b/src/video/uikit/SDL_uikitwindow.m
@@ -108,6 +108,8 @@ static bool SetupWindowData(SDL_VideoDevice *_this, SDL_Window *window, UIWindow
     window->x = 0;
     window->y = 0;
 #endif
+    // Voxelium: the size the app asked for, to tell it the size it got (below).
+    const int requested_w = window->w, requested_h = window->h;
     window->w = width;
     window->h = height;
 
@@ -127,6 +129,22 @@ static bool SetupWindowData(SDL_VideoDevice *_this, SDL_Window *window, UIWindow
     SDL_SetPointerProperty(props, SDL_PROP_WINDOW_UIKIT_WINDOW_POINTER, (__bridge void *)data.uiwindow);
     SDL_SetNumberProperty(props, SDL_PROP_WINDOW_UIKIT_METAL_VIEW_TAG_NUMBER, SDL_METALVIEW_TAG);
 
+    /* Voxelium: the window takes the screen's size here without an event, and
+     * the view controller's later resize event is dropped when the size is
+     * unchanged (already landscape). Minecraft 26.3 learns its window size
+     * only from SDL_EVENT_WINDOW_RESIZED, so it kept its requested 854x480 and
+     * mapped taps with it: they missed the buttons whenever the game started
+     * with the phone already in landscape. */
+    if (requested_w != width || requested_h != height) {
+        SDL_Event event;
+        SDL_zero(event);
+        event.type = SDL_EVENT_WINDOW_RESIZED;
+        event.window.windowID = window->id;
+        event.window.data1 = width;
+        event.window.data2 = height;
+        SDL_PushEvent(&event);
+    }
+
     return true;
 }
 
@@ -399,7 +417,7 @@ void UIKit_GetWindowSizeInPixels(SDL_VideoDevice *_this, SDL_Window *window, int
 
         if (window->flags & SDL_WINDOW_HIGH_PIXEL_DENSITY) {
 #ifndef SDL_PLATFORM_VISIONOS
-            scale = windata.uiwindow.screen.nativeScale;
+            scale = windata.uiwindow.screen.nativeScale * UIKit_VoxeliumRenderScale();
 #else
             scale = 2.0;
 #endif
