+ */
+static PFN_vkGetInstanceProcAddr bare_icd_gipa;
+
+static VKAPI_ATTR VkResult VKAPI_CALL
+bare_icd_enumerate_instance_layer_properties(uint32_t *count, VkLayerProperties *props)
+{
+   *count = 0;
+   return VK_SUCCESS;
+}
+
+static VKAPI_ATTR PFN_vkVoidFunction VKAPI_CALL
+bare_icd_get_instance_proc_addr(VkInstance instance, const char *name)
+{
+   if (!strcmp(name, "vkEnumerateInstanceLayerProperties"))
+      return (PFN_vkVoidFunction)bare_icd_enumerate_instance_layer_properties;
+   return bare_icd_gipa(instance, name);
