diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index 22f4bf7..f20e54a 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -58,7 +58,27 @@ kk_cmd_release_resources(struct kk_device *dev, struct kk_cmd_buffer *cmd)
    util_dynarray_clear(&cmd->ts_stage_map);
 }
 
-/* Ends Metal command buffer recording and returns allocator to pool for reuse */
+/* Resets the command buffer's Metal allocator and returns it to the pool.
+ *
+ * Only call this once the GPU is done with the command buffer: on reset or
+ * destroy, which Vulkan forbids while the command buffer is pending. A
+ * MTL4CommandAllocator keeps the memory of everything encoded with it until
+ * it is reset, so returning it unreset at the end of recording (as before)
+ * let the next command buffer encode into it while the old work was still in
+ * flight, and its memory grew every frame. */
+static void
+release_allocator(struct kk_cmd_buffer *cmd)
+{
+   if (!cmd->metal.allocator)
+      return;
+
+   mtl_command_allocator_reset(cmd->metal.allocator);
+   kk_cmd_pool_return_allocator(kk_cmd_buffer_pool(cmd), cmd->metal.allocator);
+   cmd->metal.allocator = NULL;
+}
+
+/* Ends Metal command buffer recording. The allocator stays with the command
+ * buffer until release_allocator(). */
 static void
 end_recording(struct kk_cmd_buffer *cmd)
 {
@@ -67,8 +87,6 @@ end_recording(struct kk_cmd_buffer *cmd)
 
    cs_end(cmd);
    mtl_end_command_buffer(cmd->metal.cmd_buf);
-   kk_cmd_pool_return_allocator(kk_cmd_buffer_pool(cmd), cmd->metal.allocator);
-   cmd->metal.allocator = NULL;
 }
 
 static void
@@ -83,6 +101,7 @@ kk_destroy_cmd_buffer(struct vk_command_buffer *vk_cmd_buffer)
 
    /* Ensure closed command buffer for safe returns to pool */
    end_recording(cmd);
+   release_allocator(cmd);
    if (cmd->metal.cmd_buf)
       kk_cmd_pool_return_cmd_buf(pool, cmd->metal.cmd_buf);
    cmd->metal.cmd_buf = NULL;
@@ -163,6 +182,7 @@ kk_reset_cmd_buffer_internal(struct kk_cmd_buffer *cmd)
 
    /* Ensure closed command buffer so we can start it again */
    end_recording(cmd);
+   release_allocator(cmd);
    kk_cmd_release_resources(dev, cmd);
 
    cmd->uploader.bo = NULL;
