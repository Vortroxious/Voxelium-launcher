+    */
+   bool subgroup_fp64_ok = screen->info.feats.features.shaderFloat64 ||
+                           screen->info.driver_props.driverID == VK_DRIVER_ID_MESA_KOSMICKRISP;
+   if (screen->info.feats12.subgroupBroadcastDynamicId && screen->info.feats12.shaderSubgroupExtendedTypes && subgroup_fp64_ok) {
       caps->shader_subgroup_size = screen->info.subgroup.subgroupSize;
       if (screen->info.have_EXT_mesh_shader)
          caps->shader_subgroup_supported_stages = screen->info.subgroup.supportedStages & BITFIELD_MASK(MESA_SHADER_MESH_STAGES);
