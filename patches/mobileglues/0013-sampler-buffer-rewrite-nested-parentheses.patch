+// uint(chunkId))) became invalid GLSL, glslang failed, and the untranslated desktop
+// shader reached ANGLE ("'core' : invalid version directive"). It also rewrote
+// texelFetch on every sampler, not just buffer ones. This version finds the buffer
+// samplers by declaration and rewrites only their texelFetch calls, matching
+// parentheses.
+static size_t voxelium_matching_paren(const std::string& s, size_t open) {
+    int depth = 0;
+    for (size_t i = open; i < s.size(); i++) {
+        if (s[i] == '(') depth++;
+        else if (s[i] == ')' && --depth == 0) return i;
+    }
+    return std::string::npos;
+}
