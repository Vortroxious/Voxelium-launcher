+static void voxelium_report_attachment(GLenum attachment, const char* name) {
+    GLint type = GL_NONE;
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment,
+                                               GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &type);
+    if (type == GL_NONE) { GLES.glGetError(); return; }
+    GLint object = 0, ctype = 0, r = 0, g = 0, b = 0, a = 0, d = 0, s = 0;
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME, &object);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_COMPONENT_TYPE, &ctype);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_RED_SIZE, &r);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_GREEN_SIZE, &g);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_BLUE_SIZE, &b);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_ALPHA_SIZE, &a);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_DEPTH_SIZE, &d);
+    GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, attachment, GL_FRAMEBUFFER_ATTACHMENT_STENCIL_SIZE, &s);
+    GLES.glGetError();
+    fprintf(stderr, "[MG-FBO]   %s: %s %d, component type 0x%X, bits R%d G%d B%d A%d D%d S%d\n", name,
+            type == GL_TEXTURE ? "texture" : "renderbuffer", object, ctype, r, g, b, a, d, s);
+}
+static void voxelium_check_draw_framebuffer(GLuint fbo) {
+    static std::set<std::pair<GLuint, GLenum>> reported;
+    static int checks = 0;
+    if (fbo == 0) return;
+    GLenum status = GLES.glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER);
+    if (++checks == 1) fprintf(stderr, "[MG-FBO] framebuffer completeness reporting on\n");
+    if (status == GL_FRAMEBUFFER_COMPLETE || reported.size() >= 60 || !reported.insert({fbo, status}).second) return;
+    fprintf(stderr, "[MG-FBO] framebuffer %u INCOMPLETE: 0x%X\n", fbo, status);
+    static const char* names[] = {"color0", "color1", "color2", "color3", "color4", "color5", "color6", "color7"};
+    for (int i = 0; i < 8; i++) voxelium_report_attachment(GL_COLOR_ATTACHMENT0 + i, names[i]);
+    voxelium_report_attachment(GL_DEPTH_ATTACHMENT, "depth");
+    voxelium_report_attachment(GL_STENCIL_ATTACHMENT, "stencil");
+    GLint bufs[8] = {0};
+    for (int i = 0; i < 8; i++) GLES.glGetIntegerv(GL_DRAW_BUFFER0 + i, &bufs[i]);
+    GLES.glGetError();
+    fprintf(stderr, "[MG-FBO]   draw buffers: 0x%X 0x%X 0x%X 0x%X 0x%X 0x%X 0x%X 0x%X\n", bufs[0], bufs[1], bufs[2],
+            bufs[3], bufs[4], bufs[5], bufs[6], bufs[7]);
+}
