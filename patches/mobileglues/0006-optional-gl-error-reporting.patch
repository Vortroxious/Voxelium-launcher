diff --git a/src/main/cpp/gles/loader.h b/src/main/cpp/gles/loader.h
index 21c1939..9b80c27 100644
--- a/src/main/cpp/gles/loader.h
+++ b/src/main/cpp/gles/loader.h
@@ -74,6 +74,28 @@ extern "C"
         LOG_E("ERROR: %d @ %s:%d", ERR, __FILE__, __LINE__)                                                            \
         ERR = GLES.glGetError();                                                                                       \
     }
+#elif defined(VOXELIUM_CHECK_GL_ERRORS)
+// Voxelium diagnostic build (-DVOXELIUM_CHECK_GL_ERRORS): after each checked call,
+// read ANGLE's real error and print it with the MobileGlues function, file and line
+// (the normal build hides GLES errors). Capped so the log stays readable.
+#include <stdio.h>
+static inline void voxelium_report_gl_error(unsigned int err, const char *file, int line, const char *fn) {
+    static int reported = 0;
+    if (reported < 400 || reported % 1000 == 0)
+        fprintf(stderr, "[MG-GLERR] 0x%04X in %s (%s:%d) #%d\n", err, fn, file, line, reported);
+    reported++;
+}
+#define CHECK_GL_ERROR                                                                                                 \
+    {                                                                                                                  \
+        GLenum VOXELIUM_ERR = GLES.glGetError();                                                                         \
+        while (VOXELIUM_ERR != GL_NO_ERROR) {                                                                            \
+            voxelium_report_gl_error(VOXELIUM_ERR, __FILE__, __LINE__, __func__);                                         \
+            VOXELIUM_ERR = GLES.glGetError();                                                                            \
+        }                                                                                                              \
+    }
+#define INIT_CHECK_GL_ERROR                                                                                            \
+    {}
+#define CHECK_GL_ERROR_NO_INIT CHECK_GL_ERROR
 #else
 #define CHECK_GL_ERROR                                                                                                 \
     {}
