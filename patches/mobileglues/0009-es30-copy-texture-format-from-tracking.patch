+}
+
+// Voxelium: glGetTexLevelParameteriv only exists from OpenGL ES 3.1. On ES 3.0 (ANGLE
+// Metal) it fails with GL_INVALID_OPERATION and leaves its output unset, so the copy
+// functions below read the format of the bound texture from MobileGlues' own
+// tracking instead, and the getters answer from it.
+static TextureObject* voxelium_bound_texture(GLenum target) {
+    switch (target) {
+    case GL_TEXTURE_CUBE_MAP_POSITIVE_X:
+    case GL_TEXTURE_CUBE_MAP_NEGATIVE_X:
+    case GL_TEXTURE_CUBE_MAP_POSITIVE_Y:
+    case GL_TEXTURE_CUBE_MAP_NEGATIVE_Y:
+    case GL_TEXTURE_CUBE_MAP_POSITIVE_Z:
+    case GL_TEXTURE_CUBE_MAP_NEGATIVE_Z:
+        target = GL_TEXTURE_CUBE_MAP;
+        break;
+    default:
+        break;
+    }
+    return mgGetTexObjectByTarget(target);
+}
+
+static GLint voxelium_bound_internal_format(GLenum target, GLint level) {
+    if (hardware->es_version >= 310) {
+        GLint format = 0;
+        GLES.glGetTexLevelParameteriv(target, level, GL_TEXTURE_INTERNAL_FORMAT, &format);
+        return format;
+    }
+    TextureObject* tex = voxelium_bound_texture(target);
+    return tex ? (GLint)tex->internal_format : 0;
+}
+
+// The tracked answer for glGetTexLevelParameter* below ES 3.1; false if unknown.
+static bool voxelium_tracked_level_parameter(GLenum target, GLint level, GLenum pname, GLint* out) {
+    if (hardware->es_version >= 310) return false;
+    TextureObject* tex = voxelium_bound_texture(target);
+    switch (pname) {
+    case GL_TEXTURE_WIDTH:
+        *out = tex ? nlevel(tex->width, level) : 0;
+        return true;
+    case GL_TEXTURE_HEIGHT:
+        *out = tex ? nlevel(tex->height, level) : 0;
+        return true;
+    case GL_TEXTURE_DEPTH:
+        *out = tex ? (tex->depth > 0 ? nlevel(tex->depth, level) : 1) : 0;
+        return true;
+    case GL_TEXTURE_INTERNAL_FORMAT:
+        *out = tex ? (GLint)tex->internal_format : 0;
+        return true;
+    default:
+        *out = 0;
+        return true;
     }
 }
 
