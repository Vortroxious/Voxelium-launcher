diff --git a/src/main/cpp/gl/gl.cpp b/src/main/cpp/gl/gl.cpp
index e5b7e15..027aea1 100644
--- a/src/main/cpp/gl/gl.cpp
+++ b/src/main/cpp/gl/gl.cpp
@@ -11,6 +11,20 @@
 #include "mg.h"
 #include "framebuffer.h"
 
+// Voxelium: per-draw-buffer colour masks are core only from OpenGL ES 3.2, and
+// ANGLE's Metal backend gives an ES 3.0 context, which rejects glColorMaski.
+// Minecraft 26.2's GlStateManager sets every colour mask with glColorMaski (26.1
+// used glColorMask), so once a pass turned colour writes off they never came back
+// on, and 26.2 drew only its first red frames, then black. Below ES 3.2, apply
+// buffer 0's mask (the main image) with glColorMask; ES 3.0 has no per-buffer masks.
+extern "C" GLAPI GLAPIENTRY void glColorMaski(GLuint index, GLboolean r, GLboolean g, GLboolean b, GLboolean a) {
+    if (g_gles_caps.major > 3 || (g_gles_caps.major == 3 && g_gles_caps.minor >= 2)) {
+        GLES.glColorMaski(index, r, g, b, a);
+    } else if (index == 0) {
+        GLES.glColorMask(r, g, b, a);
+    }
+}
+
 #define DEBUG 0
 
 static GLclampd currentDepthValue;
