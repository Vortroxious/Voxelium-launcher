 // texelFetch on every sampler, not just buffer ones. This version finds the buffer
 // samplers by declaration and rewrites only their texelFetch calls, matching
 // parentheses.
+// Names of uniforms declared as [iu]samplerBuffer in any shader so far. The draw-time
+// setup points only these at the emulated buffer texture (unit 15); upstream pointed
+// every sampler2D and isampler2D there, so Sodium 0.9's block and light textures were
+// redirected too and ANGLE refused its chunk draws ("Two textures of different types
+// use the same sampler location"): the world rendered without terrain.
+static std::set<std::string> voxelium_buffer_sampler_names;
+
+void voxelium_note_buffer_samplers(const std::string& glsl) {
+    if (glsl.find("samplerBuffer") == std::string::npos) return;
+    std::regex decl(R"(\b(i|u)?samplerBuffer\s+(\w+))");
+    for (std::sregex_iterator it(glsl.begin(), glsl.end(), decl), end; it != end; ++it)
+        voxelium_buffer_sampler_names.insert((*it)[2].str());
+}
+
+bool voxelium_is_buffer_sampler(const char* uniform_name) {
+    std::string name(uniform_name);
+    size_t bracket = name.find('[');
+    if (bracket != std::string::npos) name.resize(bracket);
+    return voxelium_buffer_sampler_names.count(name) > 0;
+}
