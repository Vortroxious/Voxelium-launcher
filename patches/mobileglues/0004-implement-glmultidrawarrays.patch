 typedef void (*glMultiDrawElementsBaseVertex_t)(GLenum, GLsizei*, GLenum, const void* const*, GLsizei, const GLint*);
 
+// Zalith iOS: glMultiDrawArrays was only a stub (gl_stub.cpp), so every multi-draw of
+// non-indexed geometry drew nothing. Minecraft 26.2 is the first version to use it,
+// and showed only the clear colour (red loading screen without the logo, then black).
+// OpenGL ES 3.0 has no multi-draw: issue one glDrawArrays per draw, exactly as if
+// the caller had made those calls (glDrawArrays is a plain passthrough here).
+extern "C" GLAPI GLAPIENTRY void glMultiDrawArrays(GLenum mode, const GLint* first, const GLsizei* count, GLsizei drawcount) {
+    LOG()
+    if (!first || !count) return;
+    for (GLsizei i = 0; i < drawcount; ++i) {
+        if (count[i] > 0) glDrawArrays(mode, first[i], count[i]);
+    }
+}
