+#ifdef __APPLE__
+// Zalith iOS: initialise on first use instead of at load time. Minecraft 26.2 loads
+// the GL library (LWJGL GL.getFunctionProvider) before it creates its window, so
+// load-time init set MobileGlues up against EGL/GLES state that is not the game's
+// (its own default display, made before the app's ANGLE display and context) and
+// 26.2 drew nothing but the clear colour. The first GL entry points LWJGL calls
+// (glGetIntegerv/glGetString/glGetStringi/glGetError, see gl/getter.cpp) call this
+// with the game's context current, the order in which 26.1 and older already work.
+#include <atomic>
+static std::atomic<int> g_mg_init_state{0};  // 0 not started, 1 running, 2 done
+extern "C" void mg_ensure_init() {
+    if (g_mg_init_state.load(std::memory_order_acquire) == 2) return;
+    int expected = 0;
+    if (g_mg_init_state.compare_exchange_strong(expected, 1)) {
+        proc_init();
+        g_mg_init_state.store(2, std::memory_order_release);
+    }
+    // state 1: called from inside proc_init itself; carry on without waiting.
+}
+#else
+static static_block_t static_block;
+#endif
\ No newline at end of file
