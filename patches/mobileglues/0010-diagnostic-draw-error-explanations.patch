+#ifdef VOXELIUM_CHECK_GL_ERRORS
+// ANGLE explains every error it raises through KHR_debug; print each distinct message
+// (first 5 times, then every 1000th), at most 300 distinct messages. Debug output is
+// per context: MobileGlues initialises on a context of its own (patch 0001 restores the
+// game's afterwards), so glBindFramebuffer installs this again on the game's context.
+void voxelium_install_angle_debug(const char* where) {
+    typedef void (*VoxeliumDebugProc)(GLenum, GLenum, GLuint, GLenum, GLsizei, const GLchar*, const void*);
+    typedef void (*VoxeliumSetCallback)(VoxeliumDebugProc, const void*);
+    auto set_callback = (VoxeliumSetCallback)dlsym(RTLD_DEFAULT, "glDebugMessageCallbackKHR");
+    if (!set_callback) {
+        fprintf(stderr, "[MG-CAPS] glDebugMessageCallbackKHR not found (%s)\n", where);
+        return;
+    }
+    set_callback(
+        [](GLenum source, GLenum type, GLuint id, GLenum severity, GLsizei, const GLchar* message, const void*) {
+            static std::unordered_map<std::string, int> seen;
+            std::string text = message ? message : "";
+            auto it = seen.find(text);
+            if (it == seen.end()) {
+                if (seen.size() >= 300) return;
+                it = seen.emplace(text, 0).first;
+            }
+            int n = it->second++;
+            if (n < 5 || n % 1000 == 0)
+                fprintf(stderr, "[MG-ANGLE] #%d type 0x%X severity 0x%X id %u: %s\n", n, type, severity, id,
+                        text.c_str());
+        },
+        nullptr);
+    GLES.glEnable(0x92E0); // GL_DEBUG_OUTPUT_KHR
+    GLES.glEnable(0x8242); // GL_DEBUG_OUTPUT_SYNCHRONOUS_KHR
+    GLboolean on = GLES.glIsEnabled(0x92E0);
+    GLES.glGetError();
+    fprintf(stderr, "[MG-CAPS] ANGLE debug messages %s (%s)\n", on ? "on" : "NOT on", where);
+}
+#endif
+
