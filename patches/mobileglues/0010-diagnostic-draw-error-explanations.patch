+#ifdef VOXELIUM_CHECK_GL_ERRORS
+#include <set>
+static const char* voxelium_sampler_kind(GLenum t, GLenum* binding) {
+    switch (t) {
+    case GL_SAMPLER_2D: *binding = GL_TEXTURE_BINDING_2D; return "sampler2D";
+    case GL_SAMPLER_2D_SHADOW: *binding = GL_TEXTURE_BINDING_2D; return "sampler2DShadow";
+    case GL_INT_SAMPLER_2D: *binding = GL_TEXTURE_BINDING_2D; return "isampler2D";
+    case GL_UNSIGNED_INT_SAMPLER_2D: *binding = GL_TEXTURE_BINDING_2D; return "usampler2D";
+    case GL_SAMPLER_3D: *binding = GL_TEXTURE_BINDING_3D; return "sampler3D";
+    case GL_INT_SAMPLER_3D: *binding = GL_TEXTURE_BINDING_3D; return "isampler3D";
+    case GL_UNSIGNED_INT_SAMPLER_3D: *binding = GL_TEXTURE_BINDING_3D; return "usampler3D";
+    case GL_SAMPLER_CUBE: *binding = GL_TEXTURE_BINDING_CUBE_MAP; return "samplerCube";
+    case GL_SAMPLER_CUBE_SHADOW: *binding = GL_TEXTURE_BINDING_CUBE_MAP; return "samplerCubeShadow";
+    case GL_SAMPLER_2D_ARRAY: *binding = GL_TEXTURE_BINDING_2D_ARRAY; return "sampler2DArray";
+    case GL_SAMPLER_2D_ARRAY_SHADOW: *binding = GL_TEXTURE_BINDING_2D_ARRAY; return "sampler2DArrayShadow";
+    case GL_INT_SAMPLER_2D_ARRAY: *binding = GL_TEXTURE_BINDING_2D_ARRAY; return "isampler2DArray";
+    case GL_UNSIGNED_INT_SAMPLER_2D_ARRAY: *binding = GL_TEXTURE_BINDING_2D_ARRAY; return "usampler2DArray";
+    default: *binding = 0; return nullptr;
+    }
+}
+
+void voxelium_explain_draw_error(GLenum err, const char* fn, GLenum mode, GLsizei count, GLenum type,
+                                 const void* indices) {
+    static int failures = 0;
+    static std::set<GLint> explained;
+    failures++;
+    if (failures % 2000 == 0) fprintf(stderr, "[MG-DRAW] %d failed draws so far\n", failures);
+    GLint prog = 0;
+    GLES.glGetIntegerv(GL_CURRENT_PROGRAM, &prog);
+    if (explained.size() >= 40 || !explained.insert(prog).second) return;
+
+    GLint fbo = 0, ebo = 0, vao = 0;
+    GLES.glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &fbo);
+    GLES.glGetIntegerv(GL_ELEMENT_ARRAY_BUFFER_BINDING, &ebo);
+    GLES.glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &vao);
+    fprintf(stderr, "[MG-DRAW] %s error 0x%04X: program %d, mode 0x%X count %d type 0x%X indices %p, fbo %d, "
+            "element buffer %d, vao %d\n", fn, err, prog, mode, count, type, indices, fbo, ebo, vao);
+    if (prog == 0) return;
+
+    GLint linked = 0, valid = 0;
+    GLES.glGetProgramiv(prog, GL_LINK_STATUS, &linked);
+    GLES.glValidateProgram(prog);
+    GLES.glGetProgramiv(prog, GL_VALIDATE_STATUS, &valid);
+    char log[1024] = {0};
+    GLES.glGetProgramInfoLog(prog, sizeof(log) - 1, nullptr, log);
+    fprintf(stderr, "[MG-DRAW]   linked %d, validates %d: %s\n", linked, valid, log);
+
+    // Framebuffer attachments, to spot feedback loops.
+    GLint attached[10] = {0};
+    for (int i = 0; i < 10; i++) {
+        GLenum a = i < 8 ? GL_COLOR_ATTACHMENT0 + i : (i == 8 ? GL_DEPTH_ATTACHMENT : GL_STENCIL_ATTACHMENT);
+        GLint t = GL_NONE;
+        if (fbo != 0) {
+            GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, a, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_TYPE, &t);
+            if (t == GL_TEXTURE)
+                GLES.glGetFramebufferAttachmentParameteriv(GL_DRAW_FRAMEBUFFER, a, GL_FRAMEBUFFER_ATTACHMENT_OBJECT_NAME,
+                                                           &attached[i]);
+        }
+    }
+    fprintf(stderr, "[MG-DRAW]   fbo textures: c0 %d c1 %d c2 %d c3 %d c4 %d c5 %d c6 %d c7 %d depth %d stencil %d\n",
+            attached[0], attached[1], attached[2], attached[3], attached[4], attached[5], attached[6], attached[7],
+            attached[8], attached[9]);
+
+    // Samplers: two different sampler types on one unit is an error on ES 3.0.
+    GLint active_unit = 0, uniforms = 0;
+    GLES.glGetIntegerv(GL_ACTIVE_TEXTURE, &active_unit);
+    GLES.glGetProgramiv(prog, GL_ACTIVE_UNIFORMS, &uniforms);
+    for (GLint i = 0; i < uniforms; i++) {
+        char name[128] = {0};
+        GLint size = 0;
+        GLenum utype = 0;
+        GLES.glGetActiveUniform(prog, i, sizeof(name) - 1, nullptr, &size, &utype, name);
+        GLenum binding = 0;
+        const char* kind = voxelium_sampler_kind(utype, &binding);
+        if (!kind) continue;
+        GLint loc = GLES.glGetUniformLocation(prog, name), unit = -1, tex = 0;
+        if (loc >= 0) GLES.glGetUniformiv(prog, loc, &unit);
+        if (unit >= 0 && unit < 32) {
+            GLES.glActiveTexture(GL_TEXTURE0 + unit);
+            GLES.glGetIntegerv(binding, &tex);
+        }
+        bool loop = false;
+        for (int a = 0; a < 10; a++) loop |= (tex != 0 && attached[a] == tex);
+        fprintf(stderr, "[MG-DRAW]   %s %s -> unit %d, texture %d%s\n", kind, name, unit, tex,
+                loop ? "  <-- ALSO ATTACHED TO THE FRAMEBUFFER (feedback loop)" : "");
+    }
+    GLES.glActiveTexture(active_unit);
+
+    // Uniform blocks: ANGLE rejects draws when a block's buffer is missing or too small.
+    GLint blocks = 0;
+    GLES.glGetProgramiv(prog, GL_ACTIVE_UNIFORM_BLOCKS, &blocks);
+    for (GLint b = 0; b < blocks; b++) {
+        char name[128] = {0};
+        GLint point = -1, data_size = 0, buf = 0;
+        GLint64 start = 0, bsize = 0;
+        GLES.glGetActiveUniformBlockName(prog, b, sizeof(name) - 1, nullptr, name);
+        GLES.glGetActiveUniformBlockiv(prog, b, GL_UNIFORM_BLOCK_BINDING, &point);
+        GLES.glGetActiveUniformBlockiv(prog, b, GL_UNIFORM_BLOCK_DATA_SIZE, &data_size);
+        if (point >= 0) {
+            GLES.glGetIntegeri_v(GL_UNIFORM_BUFFER_BINDING, point, &buf);
+            GLES.glGetInteger64i_v(GL_UNIFORM_BUFFER_START, point, &start);
+            GLES.glGetInteger64i_v(GL_UNIFORM_BUFFER_SIZE, point, &bsize);
+        }
+        fprintf(stderr, "[MG-DRAW]   block %s binding %d needs %d bytes: buffer %d start %lld size %lld%s\n", name,
+                point, data_size, buf, (long long)start, (long long)bsize,
+                buf == 0 ? "  <-- NO BUFFER" : (bsize != 0 && bsize < data_size ? "  <-- TOO SMALL" : ""));
+    }
+
+    // Enabled vertex attributes without a buffer (client arrays) fail on ANGLE.
+    for (GLuint a = 0; a < 16; a++) {
+        GLint enabled = 0, abuf = 0, asize = 0, atype = 0, integer = 0;
+        GLES.glGetVertexAttribiv(a, GL_VERTEX_ATTRIB_ARRAY_ENABLED, &enabled);
+        if (!enabled) continue;
+        GLES.glGetVertexAttribiv(a, GL_VERTEX_ATTRIB_ARRAY_BUFFER_BINDING, &abuf);
+        GLES.glGetVertexAttribiv(a, GL_VERTEX_ATTRIB_ARRAY_SIZE, &asize);
+        GLES.glGetVertexAttribiv(a, GL_VERTEX_ATTRIB_ARRAY_TYPE, &atype);
+        GLES.glGetVertexAttribiv(a, GL_VERTEX_ATTRIB_ARRAY_INTEGER, &integer);
+        fprintf(stderr, "[MG-DRAW]   attrib %u: buffer %d, %d x 0x%X%s%s\n", a, abuf, asize, atype,
+                integer ? " (integer)" : "", abuf == 0 ? "  <-- NO BUFFER" : "");
+    }
+    GLES.glGetError();
 }
+#endif
 
