diff --git a/modules/lwjgl/vma/src/main/c/vk_mem_alloc.h b/modules/lwjgl/vma/src/main/c/vk_mem_alloc.h
index f2b58bf..6e6ff34 100644
--- a/modules/lwjgl/vma/src/main/c/vk_mem_alloc.h
+++ b/modules/lwjgl/vma/src/main/c/vk_mem_alloc.h
@@ -4382,6 +4382,9 @@ inline void* VmaMalloc(const VkAllocationCallbacks* pAllocationCallbacks, size_t
     }
     else
     {
+        // Voxelium (as AngelAuraMC's fork): LWJGL routes this to its aligned_alloc, which
+        // on Apple's libc fails for alignments below sizeof(void*); VMA asks for 1 or 2.
+        if (alignment < sizeof(void*)) alignment = sizeof(void*);
         result = VMA_SYSTEM_ALIGNED_MALLOC(size, alignment);
     }
     VMA_ASSERT(result != VMA_NULL && "CPU memory allocation failed.");
